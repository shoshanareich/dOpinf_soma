# Ignore everything by default
*

# Allow the .gitignore file itself
!.gitignore

# Allow specific directories (must end with /)
!configs/
!src/

# Shell scripts: only the two published examples (the rest stay local)
!run_roms.sh

# Optional: If you want to keep specific files inside the allowed folders
!configs/**
!src/**
src/__pycache__/
*.pyc
src/.results_path_local*

# ---- Paper pipeline (curated whitelist) -------------------------------------
# analysis/ and job_scripts/ stay ignored except for the scripts that produce the
# paper's ROM, figures and numbers. Add a line here to publish another script.
!README.md
!environment.yml

!analysis/
analysis/*
# conservation-constrained refit (the paper ROM) + heat/salt budgets
!analysis/refit_conservation.py
!analysis/rom_heat_budget.py
!analysis/fom_heat_budget.py
!analysis/fom_salt_budget.py
!analysis/heat_budget_depth.py
!analysis/salt_volume_budget.py
!analysis/plot_conservation_figs.py
# field exports / derived quantities
!analysis/compute_psi_scenario.py
!analysis/compute_moc.py
!analysis/export_surface_fields.py
!analysis/export_vertical_fields.py
!analysis/export_3d_fields.py
!analysis/export_proj_surface.py
# figures
!analysis/plot_gyre_extremes.py
!analysis/plot_moc_figure.py
!analysis/plot_vertical_climatology.py
!analysis/plot_snapshots_timeseries.py
!analysis/plot_surface_snapshots.py
!analysis/plot_psi_wind_panels.py
!analysis/plot_pod_spectrum.py
!analysis/plot_compute_cost.py
!analysis/plot_longterm_stability.py
!analysis/eke_vs_tau.py
# error metrics (tables)
!analysis/surface_error_metrics.py
!analysis/volume_error_metrics.py
!analysis/depth_avg_error_metrics.py

!job_scripts/
job_scripts/*
!job_scripts/run_conserve_norm10.sh

# config of the base r=105 run (sbatch run_roms.sh trains it by default)
!configs_forcings/
configs_forcings/*
!configs_forcings/taus_2_4/
configs_forcings/taus_2_4/*
!configs_forcings/taus_2_4/config_11.json
